{
  "name": "@kreluna/ai-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "types": "wrangler types worker-configuration.d.ts --env-file .dev.vars.example",
    "typecheck": "wrangler types --check worker-configuration.d.ts --env-file .dev.vars.example && tsc --noEmit && tsc -p test/tsconfig.json && tsc -p tsconfig.config.json",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.0.0",
    "@cloudflare/workers-types": "5.20260902.1",
    "@msw/cloudflare": "0.0.1",
    "@types/node": "22.20.1",
    "msw": "^2.14.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.128.0"
  }
}
