#!/bin/bash
set -euo pipefail

APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
ROOT="$APP_DIR/Resources/app"
SUPPORT="$HOME/Library/Application Support/KrelunaDirector"
LOG="$SUPPORT/kreluna.log"

mkdir -p "$SUPPORT"
exec > >(tee -a "$LOG") 2>&1

notify() {
  osascript -e "display notification \"$1\" with title \"Kreluna Director\"" >/dev/null 2>&1 || true
}

fail() {
  osascript -e "display dialog \"$1\" buttons {\"OK\"} default button \"OK\" with title \"Kreluna Director\"" >/dev/null 2>&1 || true
  exit 1
}

ARCH="$(uname -m)"
if [[ "$ARCH" != "arm64" ]]; then
  fail "Kreluna Director è solo per Mac con chip Apple (M1, M2, M3, M4). Questo computer non è supportato."
fi

PYTHON="$APP_DIR/Resources/python-arm64/bin/python3.12"

if [[ ! -x "$PYTHON" ]]; then
  fail "Kreluna è incompleta. Chiudi e reinstalla dallo zip nuovo."
fi

export PYTHONHOME="$(cd "$(dirname "$PYTHON")/.." && pwd)"
export PYTHONPATH="$ROOT/packages/kreluna-shared/src:$ROOT/apps/director-api:$ROOT/apps/director-desktop"
export DIRECTOR_DATABASE_URL="sqlite+aiosqlite:///$SUPPORT/data/kreluna.db"
export DIRECTOR_EVIDENCE_DIR="$SUPPORT/data/evidence"
export KRELUNA_DIRECTOR_URL="http://127.0.0.1:8080"
export KRELUNA_UPDATE_URL="${KRELUNA_UPDATE_URL:-http://127.0.0.1:8080/update/manifest}"

notify "Apro Kreluna Director…"
cd "$ROOT"
exec "$PYTHON" "$ROOT/apps/director-desktop/kreluna_desktop.py"
