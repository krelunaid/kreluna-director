# Copia questo file come .env e riempi solo le righe che ti servono.
# Il file .env non va mai messo su GitHub.

# --- Collegamento all'IA (opzionale) ---
# Senza queste righe il Director funziona a regole, come prima.
# Con queste righe capisce anche le frasi libere.
#
# Grok (xAI) — chiave da console.x.ai:
# KRELUNA_LLM_BASE_URL=https://api.x.ai/v1
# KRELUNA_LLM_MODEL=grok-4.6
#
# OpenAI:
# KRELUNA_LLM_BASE_URL=https://api.openai.com/v1
# KRELUNA_LLM_MODEL=gpt-4o-mini
#
# Anthropic, Mistral, Groq o un modello in studio: cambia solo queste due righe.
# L'indirizzo deve finire con /v1 e parlare come OpenAI (/chat/completions).
KRELUNA_LLM_BASE_URL=
KRELUNA_LLM_API_KEY=
KRELUNA_LLM_MODEL=gpt-4o-mini

# --- Segreti del Director (cambiali in produzione) ---
# DIRECTOR_SIGNING_SEED=
# DIRECTOR_SESSION_SECRET=
# DIRECTOR_EVIDENCE_KEY=
