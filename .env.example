# Kreluna Director — local / demo only. Never put production secrets here.

DIRECTOR_ENV=development
DIRECTOR_HOST=127.0.0.1
DIRECTOR_PORT=8080
DIRECTOR_PUBLIC_URL=http://127.0.0.1:8080
DIRECTOR_DATABASE_URL=sqlite+aiosqlite:///./data/kreluna.db
DIRECTOR_EVIDENCE_DIR=./data/evidence
DIRECTOR_SIGNING_SEED=kreluna-dev-signing-seed-change-in-production
DIRECTOR_SESSION_SECRET=kreluna-dev-session-secret-change-in-production
DIRECTOR_EVIDENCE_KEY=kreluna-dev-evidence-key-32b-change!!
DIRECTOR_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional LLM. If empty, the deterministic Italian planner is used.
KRELUNA_LLM_BASE_URL=
KRELUNA_LLM_API_KEY=
KRELUNA_LLM_MODEL=gpt-4o-mini

# Agent
AGENT_DIRECTOR_URL=http://127.0.0.1:8080
AGENT_DIRECTOR_WSS=ws://127.0.0.1:8080/ws/agent
KRELUNA_TENANT_ID=
KRELUNA_AGENT_ID=pc-fatture
KRELUNA_AGENT_DISPLAY_NAME=PC-FATTURE
KRELUNA_AGENT_DATA_DIR=./data/agent
KRELUNA_ENROLLMENT_CODE=KRELUNA-DEV-ENROLL
