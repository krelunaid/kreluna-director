# Copia questo file come .env e riempi solo le righe che ti servono.
# Il file .env non va mai messo su GitHub.

# --- Collegamento all'IA (opzionale) ---
# Senza queste righe il Director funziona a regole, come prima.
# Con queste righe capisce anche le frasi libere.
#
# Configura uno o più provider. Il provider iniziale può essere grok, ollama o openai;
# il titolare può poi cambiarlo dalla dashboard. Modello, indirizzo e chiave restano
# separati per evitare di mostrare un modello e chiamarne un altro.
KRELUNA_LLM_PROVIDER=grok

# Grok (xAI) — chiave da console.x.ai:
KRELUNA_GROK_BASE_URL=https://api.x.ai/v1
KRELUNA_GROK_API_KEY=
KRELUNA_GROK_MODEL=grok-4.6

# Ollama locale — non usa chiavi API:
KRELUNA_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
KRELUNA_OLLAMA_MODEL=

# OpenAI:
KRELUNA_OPENAI_BASE_URL=https://api.openai.com/v1
KRELUNA_OPENAI_API_KEY=
KRELUNA_OPENAI_MODEL=

# Le vecchie KRELUNA_LLM_BASE_URL/API_KEY/MODEL restano lette per compatibilità,
# ma le nuove installazioni devono usare i campi separati sopra.

# --- Segreti del Director (cambiali in produzione) ---
# Imposta DIRECTOR_ENV=production: il Director rifiuta di avviarsi se uno di
# questi valori manca, è corto, coincide con un altro o conserva un placeholder.
# DIRECTOR_ENV=production
# DIRECTOR_SIGNING_SEED=
# DIRECTOR_SESSION_SECRET=
# DIRECTOR_EVIDENCE_KEY=
# DIRECTOR_CREDENTIAL_KEY=
# DIRECTOR_BOOTSTRAP_EMAIL=
# DIRECTOR_BOOTSTRAP_PASSWORD=
# DIRECTOR_BOOTSTRAP_NAME=Titolare studio
# DIRECTOR_BOOTSTRAP_TENANT_NAME=Studio
# DIRECTOR_BOOTSTRAP_TENANT_SLUG=studio

# I codici Agent non si configurano qui: il titolare li genera dalla scheda
# "Da installare". Sono casuali, legati a studio/ruolo, monouso e scadono.
